{
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "routes": [
    { "src": "/health", "dest": "/api/index" },
    { "src": "/(.*)", "dest": "/api/index" }
  ],
  "crons": [
    {
      "path": "/health",
      "schedule": "*/5 * * * *"
    }
  ]
}
